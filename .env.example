# ─── Database (PostgreSQL) ───────────────────────────────────────
# Local: a Postgres running on 5432. Production: Neon / Supabase connection
# string (Neon requires ?sslmode=require).
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/coin_app"

# ─── API Server ────────────────────────────────────────────────────
# Must be at least 32 characters — the server refuses to boot otherwise.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="change-me-to-a-random-string-at-least-32-chars"
JWT_EXPIRES_IN="7d"

# Local dev port for the API. In production the platform's PORT is used
# automatically (Render/Fly inject it), so leave API_PORT unset there.
API_PORT=8080
NODE_ENV=development

# Only needed when the frontend is hosted on a DIFFERENT origin than the API
# (e.g. frontend on Vercel, API on Render). Comma-separated list.
# When the API serves the built frontend itself, leave this empty.
CORS_ORIGIN="http://localhost:23508"

# ─── Market Data ─────────────────────────────────────────────────
# Binance blocks US IPs and many datacenter ranges on api.binance.com (HTTP 451).
# data-api.binance.vision is the official public market-data host and is the
# safer choice for cloud deployments — this app only uses public endpoints.
BINANCE_API_BASE="https://data-api.binance.vision/api/v3"

# Optional — falls back to an in-process memory cache when unset.
REDIS_URL=""
# ALPHA_VANTAGE_API_KEY=""
# FMP_API_KEY=""

# Absolute path to the built SPA. Defaults to
# artifacts/crypto-heatmap/dist/public — set only if you relocate the build.
# STATIC_DIR=""

# ─── Frontend (Vite dev server only) ─────────────────────────────
# Required for `dev`/`preview`; production builds default to BASE_PATH=/.
# PORT=23508
# BASE_PATH=/
# Only when the API lives on another origin — auth calls are prefixed with it.
# VITE_API_URL="https://your-api.onrender.com"
