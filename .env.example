# ─── Database (PostgreSQL) ───────────────────────────────────────
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/coin_app"

# ─── API Server ────────────────────────────────────────────────────
JWT_SECRET="change-me-to-a-random-string-at-least-32-chars"
# Test: "1m" | Production: "1h" or "7d"
JWT_EXPIRES_IN="1m"
PORT=8080
NODE_ENV=development
CORS_ORIGIN="http://localhost:23508"

# ─── Market Data (multi-provider failover) ───────────────────────
REDIS_URL="redis://localhost:6379"
